{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$root/.claude/hooks/block-edit-on-protected-branch.sh\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
